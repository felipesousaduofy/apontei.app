# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase.
# Painel do Supabase > Project Settings > API.

NEXT_PUBLIC_SUPABASE_URL=https://nome_do_projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=Chave-anon-do-painel-do-supabase

# Chave secreta (service_role), no mesmo painel, logo abaixo da anon.
# Usada só no servidor, pela tela de gerenciamento de usuários: listar todas
# as contas e excluir uma conta do Auth exige essa chave.
# Ela ignora todas as regras de RLS — nunca coloque em código de navegador,
# nunca comite o .env.local, e cadastre-a também na Vercel.
SUPABASE_SERVICE_ROLE_KEY=cole-aqui-a-chave-service-role
